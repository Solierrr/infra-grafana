{
  "uid": "solaria-overview-python",
  "title": "Python",
  "description": "ai-geographic mede HTTP de entrada; google-registry (api-google) mede chamadas às APIs Google. Selecione um serviço; as duas operações têm contratos diferentes.",
  "tags": [
    "python",
    "fastapi",
    "otel"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "options": []
      },
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "Loki"
        },
        "options": []
      },
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "Tempo",
          "value": "Tempo"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Serviço",
        "type": "custom",
        "query": "ai-geographic : ai-geographic, api-google : google-registry",
        "refresh": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "ai-geographic",
          "value": "ai-geographic"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(target_info{service_name=~\"${service:regex}\"},deployment_environment)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Indicadores essenciais",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Operações por segundo",
      "description": "ai-geographic: requisições HTTP de entrada (sem /health). api-google: chamadas a APIs Google; não é tráfego HTTP de entrada.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taxa de falhas",
      "description": "ai-geographic: respostas HTTP 5xx. api-google: chamadas Google com error_type.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"5..\"}[$__rate_interval])) or on() (0 * sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__rate_interval])))) / sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (sum(rate(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",error_type!=\"\"}[$__rate_interval])) or on() (0 * sum(rate(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__rate_interval])))) / sum(rate(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Falhas no período",
      "description": "ai-geographic: respostas HTTP 5xx. api-google: chamadas Google com error_type.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(sum(increase(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"5..\"}[$__range])) or on() (0 * sum(increase(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__range]))))",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(sum(increase(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",error_type!=\"\"}[$__range])) or on() (0 * sum(increase(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__range]))))",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latência p95 (ms)",
      "description": "ai-geographic: respostas HTTP de sucesso; api-google: chamadas Google. A duração Google é convertida de segundos para milissegundos.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"2..|3..\"}[$__rate_interval])))",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1000 * (histogram_quantile(0.95, sum by (le) (rate(google_request_duration_seconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__rate_interval])))))",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Tendências e rotas",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Operações por resultado ou capability",
      "description": "ai-geographic: 2xx, 4xx e 5xx HTTP; api-google: chamadas por capability.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"4..\"}[$__rate_interval])) or on() (0 * sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "4xx",
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"5..\"}[$__rate_interval])) or on() (0 * sum(rate(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "5xx",
          "format": "time_series"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (google_capability) (rate(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "Google: {{google_capability}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latência p95 ao longo do tempo (ms)",
      "description": "Somente respostas 2xx/3xx; p95 pode oscilar com baixo tráfego.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"2..|3..\"}[$__rate_interval])))",
          "legendFormat": "ai-geographic",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1000 * (histogram_quantile(0.95, sum by (google_capability,le) (rate(google_request_duration_seconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__rate_interval])))))",
          "legendFormat": "api-google",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Volume por rota ou capability",
      "description": "Contagem estimada no período, sem /health. O caminho deve ser parametrizado pela instrumentação.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(sum by (http_target,http_method,http_status_code) (increase(http_server_duration_milliseconds_count{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(sum by (google_capability,http_response_status_code,error_type) (increase(google_requests_total{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Latência p95 por rota ou capability (ms)",
      "description": "Percentil 95 por caminho e método, sem /health. Poucas chamadas produzem estimativas instáveis.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (http_target,http_method,le) (increase(http_server_duration_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\",http_target!=\"/health\",http_status_code=~\"2..|3..\",http_target!=\"\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1000 * (histogram_quantile(0.95, sum by (google_capability,le) (increase(google_request_duration_seconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}[$__range])))))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Investigação — logs e traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Logs do serviço selecionado",
      "description": "Selecione uma linha com trace_id para investigar no Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{service_name=~\"${service:regex}\",deployment_environment=~\"$environment\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Traces recentes do serviço selecionado",
      "description": "Traces do serviço no ambiente selecionado. Abra um trace_id dos logs para investigar a mesma requisição.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && resource.deployment.environment =~ \"${environment:regex}\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": []
}
